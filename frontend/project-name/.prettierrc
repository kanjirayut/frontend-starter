{
  "semi": true,
  "singleQuote": true,
  "jsxSingleQuote": true,
  "trailingComma": "all",
  "printWidth": 120,
  "tabWidth": 2,
  "arrowParens": "always",
  "endOfLine": "lf",
  "bracketSpacing": true,
  "bracketSameLine": false,
  "objectWrap": "preserve",
  "plugins": ["prettier-plugin-tailwindcss"],
  "tailwindConfig": "./src/styles/tailwind.config.js",
  "tailwindFunctions": ["clsx", "cva"]
}
